# Скопіюйте у .env і заповніть порожні значення. Файл .env у git не потрапляє.
# Docker Compose читає .env автоматично. Для запуску з IDE:
#   IntelliJ IDEA — плагін EnvFile або Run Configuration → Environment variables;
#   .NET — dotnet user-secrets або launchSettings.json (локально, не в git).

# Інфраструктура
POSTGRES_USER=projecthub
POSTGRES_PASSWORD=projecthub
RABBITMQ_USER=projecthub
RABBITMQ_PASSWORD=projecthub
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Публічні адреси
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# identity-service
IDENTITY_DB_URL=jdbc:postgresql://localhost:5433/identity_db
IDENTITY_DB_USER=identity_svc
IDENTITY_DB_PASSWORD=identity_dev
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32 випадкові байти в base64, наприклад: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=
# У профілі dev ключ генерується сам, якщо файла немає
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=projecthub

# project-service
PROJECT_DB_URL=jdbc:postgresql://localhost:5433/project_db
PROJECT_DB_USER=project_svc
PROJECT_DB_PASSWORD=project_dev
MAIL_HOST=localhost
MAIL_PORT=1025

# Адреса identity для перевірки JWT (усередині мережі)
IDENTITY_URL=http://localhost:8081

# board-service
BOARD_DB_CONNECTION=Host=localhost;Port=5433;Database=board_db;Username=board_svc;Password=board_dev

# activity-service
ACTIVITY_DB_CONNECTION=Host=localhost;Port=5433;Database=activity_db;Username=activity_svc;Password=activity_dev
ACTIVITY_INACTIVITY_DAYS=30
